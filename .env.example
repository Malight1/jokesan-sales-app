# StockFlow — copy this file to `.env` (leading dot) and fill in real values.
# CRA only exposes vars prefixed with REACT_APP_ to the browser, and only
# reads `.env` — a file named `env` is silently ignored.
# Restart `npm start` after any change; CRA reads these at build time.

# Supabase — Project Settings → API
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Paystack — PUBLIC key only (safe for the browser).
# The SECRET key belongs solely in the Supabase Edge Function config
# as PAYSTACK_SECRET_KEY. Never put it here.
REACT_APP_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
